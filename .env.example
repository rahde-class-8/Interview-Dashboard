# Copy to .env.local for local development (`npm run env:local` writes the
# Supabase values for you from `supabase status`). Never commit .env.local.
# Full reference: docs/backend/ENVIRONMENT.md

# --- Browser-exposed (NEXT_PUBLIC_*) — public values only -------------------

# Supabase API gateway URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable (anon-level) key. Safe in the browser; access is limited by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Maximum size (MB) for recording uploads. Default: 100
NEXT_PUBLIC_MAX_RECORDING_SIZE_MB=100

# --- Server-only — never prefix with NEXT_PUBLIC_, never commit real values ---

# Secret (service-role-level) key. Bypasses RLS. Server code only.
SUPABASE_SECRET_KEY=

# Direct Postgres connection for local tooling and tests.
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=
